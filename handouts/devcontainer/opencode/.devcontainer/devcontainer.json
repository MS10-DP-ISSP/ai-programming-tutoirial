{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "mounts": [
    "source=opencode-config,target=/home/vscode/.config/opencode,type=volume",
    "source=opencode-data,target=/home/vscode/.local/share/opencode,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.config /home/vscode/.local && npm install -g opencode-ai@1.18.33"
}
